# ==========================================================================
# IsoRideaux — configuration Apache / LiteSpeed (hébergement mutualisé)
# Copié tel quel à la racine de dist/ par Vite : à envoyer par FTP avec le site.
# ==========================================================================

Options -Indexes
DirectoryIndex index.html index.php
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType font/woff2 .woff2

# --------------------------------------------------------------------------
# HTTPS & domaine
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force le HTTPS (le certificat SSL doit être actif sur l'hébergement).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Ancien domaine → nouveau domaine. À décommenter le jour où isorideaux.fr
  # pointe vers ce même hébergement que pvcrideaux.fr.
  # RewriteCond %{HTTP_HOST} ^(www\.)?pvcrideaux\.fr$ [NC]
  # RewriteRule ^ https://www.isorideaux.fr%{REQUEST_URI} [L,R=301]

  # Dossiers de code et de données de l'espace d'édition : jamais servis.
  # (Chacun a aussi son propre .htaccess « Require all denied ».)
  RewriteRule ^(lib|content|content-initial)(/|$) - [F,L]
  RewriteRule ^blog/_layout\.html$ - [F,L]
  RewriteRule ^uploads/.*\.(php\d?|phtml|phar|cgi|pl|py|sh)$ - [F,L]

  # Blog : pages rendues par PHP (blog/*.php)
  RewriteRule ^blog/feed\.xml$ blog/feed.php [L]
  RewriteRule ^sitemap-blog\.xml$ blog/sitemap.php [L]
  RewriteRule ^blog/([a-z0-9]+(?:-[a-z0-9]+)*)$ /blog/$1/ [R=301,L]
  RewriteRule ^blog/([a-z0-9]+(?:-[a-z0-9]+)*)/$ blog/article.php?slug=$1 [QSA,L]
</IfModule>

# --------------------------------------------------------------------------
# Redirections 301 des anciennes adresses (site WordPress pvcrideaux.fr)
# Préserve le référencement acquis et les liens existants.
# --------------------------------------------------------------------------
<IfModule mod_alias.c>
  RedirectMatch 301 ^/pvc-rideaux/?$ /a-propos/
  RedirectMatch 301 ^/rideau-laniere-pvc/?$ /professionnels/kit-rideau-lanieres/
  RedirectMatch 301 ^/laniere-pvc/?$ /professionnels/lanieres-pvc/
  RedirectMatch 301 ^/rouleau-pvc-transparent/?$ /professionnels/rouleaux-rails-accessoires/
  RedirectMatch 301 ^/rideaux-de-soudure/?$ /professionnels/rideaux-soudure/
  RedirectMatch 301 ^/rideau-chambre-froide/?$ /professionnels/chambre-froide/
  RedirectMatch 301 ^/rideaux-pvc-charriot-elevateur/?$ /professionnels/kit-rideau-lanieres/
  RedirectMatch 301 ^/rideaux-pvc-antistatiques/?$ /professionnels/
  RedirectMatch 301 ^/guide-dinstallation/?$ /guide-installation/
  RedirectMatch 301 ^/legal/?$ /mentions-legales/

  # Articles et flux de l'ancien blog WordPress → nouveau blog
  RedirectMatch 301 ^/actualites(/.*)?$ /blog/
  RedirectMatch 301 ^/feed/?$ /blog/feed.xml
  RedirectMatch 301 ^/pourquoi-installer-des-rideaux-en-pvc-lete-[^/]*/?$ /blog/rideaux-pvc-ete-chaleur-insectes/
  RedirectMatch 301 ^/kit-rideau-complet-en-pvc/?$ /blog/kit-rideau-complet-en-pvc/
  RedirectMatch 301 ^/les-portes-a-lanieres-pvc-decrochables-et-remplacables/?$ /blog/les-portes-a-lanieres-pvc-decrochables-et-remplacables/
  RedirectMatch 301 ^/portes-a-lanieres-en-pvc-souple/?$ /blog/portes-a-lanieres-en-pvc-souple/
  RedirectMatch 301 ^/barre-daccrochage-rideaux-pvc-guide-complet/?$ /blog/barre-daccrochage-rideaux-pvc-guide-complet/
  RedirectMatch 301 ^/securiser-un-atelier-de-soudure-avec-des-rideaux-pvc/?$ /blog/securiser-un-atelier-de-soudure-avec-des-rideaux-pvc/

  # Boutique WooCommerce
  RedirectMatch 301 ^/product/.*$ /professionnels/rouleaux-rails-accessoires/
  RedirectMatch 301 ^/(boutique|shop|panier|cart|commande|checkout|mon-compte)(/.*)?$ /devis/
</IfModule>

# --------------------------------------------------------------------------
# En-têtes de sécurité
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Le site ne charge aucune ressource externe. Si un outil tiers est ajouté
  # (statistiques, chat…), son domaine doit être autorisé ici.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

  # À activer une fois le HTTPS validé sur tous les sous-domaines :
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Pages HTML : toujours revalidées, pour que chaque mise en ligne soit visible.
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Fichiers statiques non versionnés (favicons, sprite d'icônes, image de partage).
  <FilesMatch "\.(ico|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# --------------------------------------------------------------------------
# Compression
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>
