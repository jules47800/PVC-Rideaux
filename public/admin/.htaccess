# Espace d'édition du blog : jamais indexé par les moteurs de recherche.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"

  # Styles et scripts de l'interface : toujours revalidés après une mise à jour.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Comptes et mots de passe : lus par PHP uniquement.
<FilesMatch "^config(\.example)?\.php$">
  Require all denied
</FilesMatch>
