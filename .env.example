# ===========================================================================
# Variables d'environnement — modèle
#
# Sur Vercel : Project → Settings → Environment Variables.
# En local : copier ce fichier en .env.local (jamais versionné) et le remplir,
# ou récupérer celles de Vercel avec `vercel env pull .env.local`.
# Voir le README, section « Hébergement sur Vercel ».
# ===========================================================================

# --- Espace d'édition du blog (/admin/) -------------------------------------
# Comptes « identifiant:empreinte », séparés par des virgules. L'empreinte se
# calcule sur /admin/connexion/ (mise en service) ou avec `npm run admin:password -- identifiant`.
ADMIN_USERS=
# Clé secrète de session, 32 caractères ou plus (générée en même temps que l'empreinte).
ADMIN_SECRET=

# Jeton GitHub « fine-grained » limité au dépôt, droit « Contents : Read and write ».
# Sans lui (en local), les articles sont enregistrés directement dans content/.
GITHUB_CONTENT_TOKEN=
# Facultatifs : déduits du déploiement Vercel s'ils sont vides.
GITHUB_CONTENT_REPO=
GITHUB_CONTENT_BRANCH=

# --- Articles programmés (tâche planifiée quotidienne, api/cron/publish.js) --
# Vercel → Settings → Git → Deploy Hooks : créer un hook sur la branche de production.
DEPLOY_HOOK_URL=
# Secret quelconque (Vercel l'envoie automatiquement à la tâche planifiée).
CRON_SECRET=

# --- Formulaires de contact et de devis (api/send.js) ------------------------
# Boîte d'envoi SMTP (hébergeur du nom de domaine, Google Workspace, Brevo…).
# En local sans SMTP_HOST, les e-mails s'affichent dans le terminal.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Adresse qui reçoit les demandes.
MAIL_TO=contact@pvcrideaux.fr
# Expéditeur, sur le même domaine que la boîte SMTP.
MAIL_FROM=no-reply@isorideaux.fr
