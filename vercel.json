{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "node tools/vercel-ignore-build.mjs",
  "regions": ["cdg1"],
  "functions": {
    "api/**/*.js": { "maxDuration": 30 }
  },
  "crons": [{ "path": "/api/cron/publish", "schedule": "0 5 * * *" }],
  "redirects": [
    { "source": "/pvc-rideaux{/}?", "destination": "/a-propos/", "permanent": true },
    {
      "source": "/rideau-laniere-pvc{/}?",
      "destination": "/professionnels/kit-rideau-lanieres/",
      "permanent": true
    },
    {
      "source": "/laniere-pvc{/}?",
      "destination": "/professionnels/lanieres-pvc/",
      "permanent": true
    },
    {
      "source": "/rouleau-pvc-transparent{/}?",
      "destination": "/professionnels/rouleaux-rails-accessoires/",
      "permanent": true
    },
    {
      "source": "/rideaux-de-soudure{/}?",
      "destination": "/professionnels/rideaux-soudure/",
      "permanent": true
    },
    {
      "source": "/rideau-chambre-froide{/}?",
      "destination": "/professionnels/chambre-froide/",
      "permanent": true
    },
    {
      "source": "/rideaux-pvc-charriot-elevateur{/}?",
      "destination": "/professionnels/kit-rideau-lanieres/",
      "permanent": true
    },
    {
      "source": "/rideaux-pvc-antistatiques{/}?",
      "destination": "/professionnels/",
      "permanent": true
    },
    {
      "source": "/guide-dinstallation{/}?",
      "destination": "/guide-installation/",
      "permanent": true
    },
    { "source": "/legal{/}?", "destination": "/mentions-legales/", "permanent": true },
    { "source": "/actualites{/(.*)}?", "destination": "/blog/", "permanent": true },
    { "source": "/feed{/}?", "destination": "/blog/feed.xml", "permanent": true },
    {
      "source": "/:slug(pourquoi-installer-des-rideaux-en-pvc-lete-[^/]*){/}?",
      "destination": "/blog/rideaux-pvc-ete-chaleur-insectes/",
      "permanent": true
    },
    {
      "source": "/kit-rideau-complet-en-pvc{/}?",
      "destination": "/blog/kit-rideau-complet-en-pvc/",
      "permanent": true
    },
    {
      "source": "/les-portes-a-lanieres-pvc-decrochables-et-remplacables{/}?",
      "destination": "/blog/les-portes-a-lanieres-pvc-decrochables-et-remplacables/",
      "permanent": true
    },
    {
      "source": "/portes-a-lanieres-en-pvc-souple{/}?",
      "destination": "/blog/portes-a-lanieres-en-pvc-souple/",
      "permanent": true
    },
    {
      "source": "/barre-daccrochage-rideaux-pvc-guide-complet{/}?",
      "destination": "/blog/barre-daccrochage-rideaux-pvc-guide-complet/",
      "permanent": true
    },
    {
      "source": "/securiser-un-atelier-de-soudure-avec-des-rideaux-pvc{/}?",
      "destination": "/blog/securiser-un-atelier-de-soudure-avec-des-rideaux-pvc/",
      "permanent": true
    },
    {
      "source": "/product{/(.*)}?",
      "destination": "/professionnels/rouleaux-rails-accessoires/",
      "permanent": true
    },
    {
      "source": "/:shop(boutique|shop|panier|cart|commande|checkout|mon-compte){/(.*)}?",
      "destination": "/devis/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/admin{/(.*)}?",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/build-info.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
